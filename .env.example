# Application Defaults
APP_NAME=PointNest
VERSION=1.0.0
PORT=8000
IS_PROD=False

# Database Configuration (TiDB Serverless Example / MySQL)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USERNAME=your_username.root
DB_PASSWORD=your_secure_password
DB_DATABASE=your_database_name

# Security
SECRET_KEY=generate_a_secure_random_string_here_like_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE=30
